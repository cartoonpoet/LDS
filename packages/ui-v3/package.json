{
  "name": "@lawkit/ui",
  "version": "0.1.14",
  "type": "module",
  "description": "LDS Design System — React component library with design tokens",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/ui-v3/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui-v3/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "lawkit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cartoonpoet/LDS.git",
    "directory": "packages/ui-v3"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "pnpm run build",
    "lint": "echo \"No lint configured yet\"",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@lds/tokens": "workspace:*",
    "@storybook/react": "^10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  }
}
